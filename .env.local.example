# ─── Database ─────────────────────────────────────────────────────────────────
# Neon PostgreSQL — get from Neon dashboard → Connection string (pooled)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── Razorpay (India payments) ────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# ─── Resend (transactional email) ─────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# ─── Cloudinary (image CDN) ───────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxx

# ─── Admin Auth ───────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=replace-with-strong-random-string-32-chars-minimum

# ─── Go Analytics Service ─────────────────────────────────────────────────────
ANALYTICS_SERVICE_URL=https://gt-analytics.fly.dev
ANALYTICS_SERVICE_SECRET=replace-with-random-bearer-token

# ─── Public env vars (exposed to browser) ────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
